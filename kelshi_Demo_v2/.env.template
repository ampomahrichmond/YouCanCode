# ===================================================
# KALSHI BOT - Environment Configuration
# Copy this to .env and fill in your values
# ===================================================

# --- Kalshi API ---
KALSHI_API_KEY_ID=your_api_key_id_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# --- Mode: demo or live ---
KALSHI_MODE=demo

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Risk Management ---
MAX_POSITION_SIZE_PCT=0.05      # 5% of balance per trade
MAX_CONCURRENT_POSITIONS=10
MAX_DAILY_LOSS_PCT=0.10         # Stop trading if daily loss > 10%
MIN_EDGE_THRESHOLD=0.05         # Minimum 5% edge before entering

# --- Strategy Settings ---
STRATEGY_VALUE_EDGE=true
STRATEGY_NO_SIDE_BIAS=true
STRATEGY_MOMENTUM=true
MIN_VOLUME=100                  # Minimum market volume to consider
MIN_OPEN_INTEREST=50
MAX_EXPIRY_HOURS=48             # Only trade markets expiring within 48h
