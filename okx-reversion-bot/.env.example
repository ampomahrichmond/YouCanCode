# Copy to .env and edit. Never commit .env.

# Trade mode: paper | demo | live
# - paper: simulator only, no exchange calls beyond market data
# - demo: OKX paper-trading endpoints (sandbox)
# - live: real money. Requires explicit UI unlock per session.
BOT_TRADE_MODE=paper

# SQLite path relative to project root, or full sqlite:/// URL, or postgres URL
DATABASE_URL=sqlite:///./data/bot.db

# Where the symmetric key for credential encryption lives.
# Generated automatically on first launch if missing.
MASTER_KEY_PATH=./data/.master.key

# CORS origin for the frontend dev server
FRONTEND_ORIGIN=http://localhost:5173

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
