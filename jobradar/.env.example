# Copy this file to .env and fill in what you use. .env is git-ignored.
# Read by the server at startup; existing environment variables take precedence.

# Claude: enables Tailor resume / Draft tailored resume / Fit summary / Cover letter
ANTHROPIC_API_KEY=

# Rotating proxies for Glassdoor / ZipRecruiter / Google (or use proxies.txt)
# JOBRADAR_PROXIES=user:pass@gate.example.com:7777

# SMTP password for the emailed digest (see digest.email in config.yaml)
# JOBRADAR_SMTP_PASSWORD=
